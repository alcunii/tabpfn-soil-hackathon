# Soil2Crop — environment variables (copy to .env and edit; .env is gitignored).
# All values here are NON-secret examples. Never commit real keys.

# --- model + data (paths; the repo ships the small reference library) ---
SOILHACK_CKPT=/opt/soil2crop/models/tabpfn-v3.5-20260909.safetensors
SOILHACK_LIBRARY=/opt/soil2crop/data/samples/reference_library.csv
TABPFN_MODEL_CACHE_SIZE=2

# --- server ---
PORT=8877

# --- OPTIONAL: an LLM to phrase the AGENT narrative (numbers are always
#     computed by the engine, never by the LLM). Leave unset for the
#     deterministic template. ---
# SOILHACK_LLM_BASE=https://api.openai.com/v1
# SOILHACK_LLM_MODEL=gpt-4o-mini
# SOILHACK_LLM_KEY=sk-...            # <-- never commit a real key
